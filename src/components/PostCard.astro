---
import type { ThemeConfig } from "../config/types";
import { loadMediaVariants, type PostEntry } from "../lib/content/queries";
import { excerpt } from "../lib/reading";
import { entryUrl } from "../lib/content/urls.mjs";
import { resolveResponsiveImage } from "../lib/media/responsive.mjs";
import { firstImage } from "../lib/thumbnail.mjs";
import PostMeta from "./PostMeta.astro";

interface Props { post: PostEntry; config: ThemeConfig; summary: string }
const { post, config, summary } = Astro.props;
const href = entryUrl(post);
const coverRaw = post.data.cover || (config.article.firstImageAsThumbnail ? firstImage(post.html) : "");
const coverImg = coverRaw
  ? resolveResponsiveImage(coverRaw, loadMediaVariants(), { preferredWidth: 960, sizes: "(max-width: 600px) 100vw, 760px" })
  : null;
const cover = coverImg?.src || "";
const coverSrcset = coverImg?.srcset || undefined;
const coverSizes = coverImg?.sizes || undefined;
const layout = config.article.listLayout;
const summaryText = summary || excerpt(post.data.description ?? "", config.article.trimWords);
const articleClasses = [
  "post card bg-white shadow-sm border-0",
  {
    "post-preview": config.article.intoArticleAnimation,
    "post-preview-layout-2": layout === "2",
    "post-preview-layout-3": layout === "3",
  },
];
---
{layout === "2" ? (
  <article class:list={articleClasses} id={"post-" + post.id}>
    <header class:list={["post-header", { "post-header-with-thumbnail": Boolean(cover) }]}>
      {cover && <img class="post-thumbnail" src={cover} srcset={coverSrcset} sizes={coverSizes} alt="" loading="lazy" decoding="async" />}
    </header>
    <div class="post-content-container">
      <a class="post-title" href={href}>{post.data.title}</a>
      {summaryText && <div class="post-content">{summaryText}</div>}
      <PostMeta post={post} config={config} />
      {post.data.tags.length > 0 && (
        <div class="post-tags">
          <i class="fa fa-tags" aria-hidden="true"></i>
          {post.data.tags.map((tag) => (
            <a class="tag badge badge-secondary post-meta-detail-tag" href={"/tags/" + encodeURIComponent(tag) + "/"}>{tag}</a>
          ))}
        </div>
      )}
    </div>
  </article>
) : layout === "3" ? (
  <article class:list={articleClasses} id={"post-" + post.id}>
    {cover && (
      <header class="post-header post-header-with-thumbnail">
        <img class="post-thumbnail" src={cover} srcset={coverSrcset} sizes={coverSizes} alt="" loading="lazy" decoding="async" />
      </header>
    )}
    <header class="post-header">
      <a class="post-title" href={href}>{post.data.title}</a>
      <PostMeta post={post} config={config} />
    </header>
    {summaryText && <div class="post-content">{summaryText}</div>}
    {post.data.tags.length > 0 && (
      <div class="post-tags">
        <i class="fa fa-tags" aria-hidden="true"></i>
        {post.data.tags.map((tag) => (
          <a class="tag badge badge-secondary post-meta-detail-tag" href={"/tags/" + encodeURIComponent(tag) + "/"}>{tag}</a>
        ))}
      </div>
    )}
  </article>
) : (
  <article class:list={articleClasses} id={"post-" + post.id}>
    <header class:list={["post-header text-center", { "post-header-with-thumbnail": Boolean(cover) }]}>
      {cover && <img class="post-thumbnail" src={cover} srcset={coverSrcset} sizes={coverSizes} alt="" loading="lazy" decoding="async" />}
      {cover ? (
        <div class="post-header-text-container">
          <a class="post-title" href={href}>{post.data.title}</a>
          <PostMeta post={post} config={config} />
        </div>
      ) : (
        <>
          <a class="post-title" href={href}>{post.data.title}</a>
          <PostMeta post={post} config={config} />
        </>
      )}
    </header>
    {summaryText && <div class="post-content">{summaryText}</div>}
    {post.data.tags.length > 0 && (
      <div class="post-tags">
        <i class="fa fa-tags" aria-hidden="true"></i>
        {post.data.tags.map((tag) => (
          <a class="tag badge badge-secondary post-meta-detail-tag" href={"/tags/" + encodeURIComponent(tag) + "/"}>{tag}</a>
        ))}
      </div>
    )}
  </article>
)}
