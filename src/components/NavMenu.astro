---
import type { MenuItem } from "../config/types";
interface Props { items: MenuItem[]; depth?: number }
const { items, depth = 0 } = Astro.props;
---
{depth === 0 ? (
  <ul class="navbar-nav navbar-nav-hover align-items-lg-center">
    {items.map((item) => (
      <li class:list={["nav-item", { dropdown: item.children.length > 0 }]}>
        <a class="nav-link" href={item.href} data-toggle={item.children.length ? "dropdown" : undefined} no-pjax={item.children.length ? "" : undefined}>
          <i class="ni ni-book-bookmark d-lg-none"></i>
          <span class="nav-link-inner--text">{item.label}</span>
        </a>
        {item.children.length > 0 && (
          <div class="dropdown-menu">
            {item.children.map((child) => child.children.length > 0 ? (
              <div class="dropdown-group">
                <a class="dropdown-item dropdown-group-toggle" href={child.href} no-pjax>
                  {child.label}
                  <i class="fa fa-angle-down dropdown-group-caret"></i>
                </a>
                <div class="dropdown-group-panel">
                  {child.children.map((grand) => (
                    <a class="dropdown-item dropdown-group-item" href={grand.href}>{grand.label}</a>
                  ))}
                </div>
              </div>
            ) : (
              <a class="dropdown-item" href={child.href}>{child.label}</a>
            ))}
          </div>
        )}
      </li>
    ))}
  </ul>
) : null}
