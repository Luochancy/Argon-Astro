---
import type { ThemeConfig } from "../config/types";
interface Props { config: ThemeConfig }
const { config } = Astro.props;
const title = config.banner.title || config.site.title;
const hidden = config.banner.size === "hide";
const isHitokoto = config.banner.subtitle.trim() === "--hitokoto--";
---
{!hidden && (
  <section id="banner" class="banner section section-lg section-shaped">
    <div class:list={["shape", config.banner.colorType, { "shape-style-1": !config.banner.hideShapes }]}>
      <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
    <div id="banner_container" class="banner-container container text-center">
      {config.banner.typing ? (
        <div class="banner-title text-white" data-interval={config.banner.typingInterval}>
          <span class="banner-title-inner" data-text={title}>&nbsp;</span>
          {config.banner.subtitle && (
            isHitokoto
              ? <span class="banner-subtitle d-block"><span class="hitokoto"></span></span>
              : <span class="banner-subtitle d-block" data-text={config.banner.subtitle}>&nbsp;</span>
          )}
        </div>
      ) : (
        <div class="banner-title text-white">
          <span class="banner-title-inner">{title}</span>
          {config.banner.subtitle && (
            isHitokoto
              ? <span class="banner-subtitle d-block"><span class="hitokoto"></span></span>
              : <span class="banner-subtitle d-block">{config.banner.subtitle}</span>
          )}
        </div>
      )}
    </div>
    {config.banner.size === "fullscreen" && (
      <div class="cover-scroll-down"><i class="fa fa-angle-down" aria-hidden="true"></i></div>
    )}
  </section>
)}
