---
import type { ThemeConfig } from "../config/types";
interface Props { config: ThemeConfig }
const { config } = Astro.props;
---
<footer id="footer" class="site-footer card shadow-sm border-0">
  {config.footer.html && <div set:html={config.footer.html}></div>}
  <div>
    Theme <a href="https://github.com/solstice23/argon-theme" target="_blank" rel="noopener"><strong>Argon</strong></a>
    {!config.footer.hideAuthor && " / Astro port"}
  </div>
</footer>
