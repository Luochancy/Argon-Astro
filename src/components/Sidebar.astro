---
import type { ThemeConfig } from "../config/types";
import { t } from "../lib/i18n";
import { renderWidgets } from "../lib/widgets.mjs";
import { renderRichMarkdown } from "../lib/rich-text.mjs";
import { publishedPosts, termCounts } from "../lib/content/queries";

interface Props { config: ThemeConfig; catalog?: boolean }
const { config, catalog = false } = Astro.props;
const lang = config.site.language;
const isZh = lang.toLowerCase().startsWith("zh");
const title = config.sidebar.bannerTitle || config.site.title;
const author = config.sidebar.authorName || config.site.title;
const announcementHtml = renderRichMarkdown(config.sidebar.announcement);
const widgets = config.sidebar.widgetsHtml || renderWidgets(config.sidebar.widgets);
const extraHtml = config.sidebar.extraHtml || "";
const rightWidgetsHtml = config.sidebar.rightWidgetsHtml || "";
const hasMultipleTabs = Boolean(catalog || widgets);

const posts = publishedPosts();
const postCount = posts.length;
const categoryEntries = [...termCounts(posts, "categories").entries()].sort((a, b) => b[1] - a[1]);
const tagEntries = [...termCounts(posts, "tags").entries()].sort((a, b) => b[1] - a[1]);
const categoryCount = categoryEntries.length;
const tagCount = tagEntries.length;

const DEFAULT_AVATAR =
  "data:image/svg+xml;base64,";
const avatarUrl = config.sidebar.authorImage || DEFAULT_AVATAR;

const normPath = (p: string) => {
  const clean = p.split(/[?#]/)[0] || "/";
  if (/\.html?$/i.test(clean)) return clean;
  return clean === "/" ? "/" : clean.replace(/\/+$/, "") + "/";
};
const iconClass = (icon?: string) => {
  const clean = String(icon || "").trim();
  if (!clean) return "";
  return /^(?:fa|ni)\s/i.test(clean) ? clean : `fa ${clean}`;
};
const isHitokoto = config.sidebar.bannerSubtitle.trim() === "--hitokoto--";
const archivesHref = config.article.archivesUrl || "/archives/";
const sidebarFriendLinks = Array.isArray(config.sidebar.friendLinks) ? config.sidebar.friendLinks : [];
const currentPath = normPath(Astro.url.pathname);
const isMenuCurrent = (href: string, children: { href: string }[] = []) => {
  if (!href || href.startsWith("http") || href === "#") return false;
  const target = normPath(href);
  if (target === currentPath) return true;
  return children.some((c) => normPath(c.href) === currentPath);
};
---
<div id="sidebar_mask"></div>
<aside id="leftbar" class="leftbar widget-area" role="complementary">
  {announcementHtml && (
    <div id="leftbar_announcement" class="card bg-white shadow-sm border-0">
      <div class="leftbar-announcement-body">
        <div class="leftbar-announcement-title text-white">{t(lang, "announcement")}</div>
        <div class="leftbar-announcement-content text-white" set:html={announcementHtml}></div>
      </div>
    </div>
  )}
  <div id="leftbar_part1" class="widget widget_search card bg-white shadow-sm border-0">
    <div class="leftbar-banner card-body">
      <span class="leftbar-banner-title text-white">{title}</span>
      {config.sidebar.bannerSubtitle && (
        <span class="leftbar-banner-subtitle text-white">
          {isHitokoto ? <span class="hitokoto"></span> : config.sidebar.bannerSubtitle}
        </span>
      )}
    </div>
    <ul id="leftbar_part1_menu" class="leftbar-menu">
      {config.sidebar.menu.map((item) => (
        <li class:list={[
          "leftbar-menu-item",
          {
            "leftbar-menu-item-haschildren": item.children.length > 0,
            current: isMenuCurrent(item.href, item.children),
          },
        ]}>
          <a href={item.href} target={item.target} rel={item.target === "_blank" ? "noopener" : undefined}>
            {item.icon && <i class={iconClass(item.icon)} aria-hidden="true"></i>}
            {item.label}
          </a>
          {item.children.length > 0 && (
            <ul class="leftbar-menu-item leftbar-menu-subitem shadow-sm">
              {item.children.map((child) => (
                <li class:list={["leftbar-menu-item", { current: isMenuCurrent(child.href) }]}>
                  <a href={child.href} target={child.target} rel={child.target === "_blank" ? "noopener" : undefined}>
                    {child.icon && <i class={iconClass(child.icon)} aria-hidden="true"></i>}
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
    <div class="card-body text-center leftbar-search-button">
      <button id="leftbar_search_container" class="btn btn-secondary btn-lg active btn-sm btn-block border-0" type="button">
        <i class="menu-item-icon fa fa-search mr-0"></i> {t(lang, "searchTitle")}
        <input id="leftbar_search_input" type="text" placeholder={t(lang, "search")} class="form-control form-control-alternative" autocomplete="off" />
      </button>
    </div>
  </div>
  <div id="leftbar_part2" class="widget widget_search card bg-white shadow-sm border-0">
    <div id="leftbar_part2_inner" class="card-body">
      <div class="nav-wrapper" style={hasMultipleTabs ? "padding-top: 5px;" : "padding-top: 5px; display: none;"}>
        <ul class="nav nav-pills nav-fill" role="tablist">
          {catalog && (
            <li class="nav-item sidebar-tab-switcher" role="presentation">
              <a class="active show" id="leftbar_tab_catalog_btn" data-toggle="tab" href="#leftbar_tab_catalog" role="tab" aria-controls="leftbar_tab_catalog" aria-selected="true" no-pjax>{t(lang, "catalog")}</a>
            </li>
          )}
          <li class="nav-item sidebar-tab-switcher" role="presentation">
            <a class:list={[{ "active show": !catalog }]} id="leftbar_tab_overview_btn" data-toggle="tab" href="#leftbar_tab_overview" role="tab" aria-controls="leftbar_tab_overview" aria-selected={!catalog ? "true" : "false"} no-pjax>{t(lang, "overview")}</a>
          </li>
          {widgets && (
            <li class="nav-item sidebar-tab-switcher" role="presentation">
              <a id="leftbar_tab_tools_btn" data-toggle="tab" href="#leftbar_tab_tools" role="tab" aria-controls="leftbar_tab_tools" aria-selected="false" no-pjax>{isZh ? "功能" : "Tools"}</a>
            </li>
          )}
        </ul>
      </div>
      <div>
        <div class="tab-content" style="padding: 10px 10px 0 10px;">
          {catalog && (
            <div class="tab-pane fade active show" id="leftbar_tab_catalog" role="tabpanel" aria-labelledby="leftbar_tab_catalog_btn">
              <div id="leftbar_catalog" data-numbers={config.article.showCatalogNumbers ? "true" : "false"}></div>
            </div>
          )}
          <div class:list={["tab-pane fade text-center", { "active show": !catalog }]} id="leftbar_tab_overview" role="tabpanel" aria-labelledby="leftbar_tab_overview_btn">
            <div id="leftbar_overview_author_image" class="rounded-circle shadow-sm" style={"background-image:url(" + avatarUrl + ")"} role="img" aria-label={author}></div>
            <h6 id="leftbar_overview_author_name">{author}</h6>
            {config.sidebar.authorDescription && <h6 id="leftbar_overview_author_description">{config.sidebar.authorDescription}</h6>}
            <nav class="site-state">
              <div class="site-state-item site-state-posts">
                <a href={archivesHref}>
                  <span class="site-state-item-count" data-count="posts">{postCount}</span>
                  <span class="site-state-item-name">{t(lang, "articles")}</span>
                </a>
              </div>
              <div class="site-state-item site-state-categories">
                <a href="#blog_categories" data-argon-modal="blog_categories" no-pjax>
                  <span class="site-state-item-count" data-count="categories">{categoryCount}</span>
                  <span class="site-state-item-name">{t(lang, "categories")}</span>
                </a>
              </div>
              <div class="site-state-item site-state-tags">
                <a href="#blog_tags" data-argon-modal="blog_tags" no-pjax>
                  <span class="site-state-item-count" data-count="tags">{tagCount}</span>
                  <span class="site-state-item-name">{t(lang, "tags")}</span>
                </a>
              </div>
            </nav>
            {config.sidebar.authorLinks.length > 0 && (
              <div class="site-author-links">
                {config.sidebar.authorLinks.map((link) => (
                  <div class="site-author-links-item">
                    <a href={link.href} rel="noopener" target="_blank">
                      {link.icon && <><i class={iconClass(link.icon)} aria-hidden="true"></i>{" "}</>}
                      {link.label}
                    </a>
                  </div>
                ))}
              </div>
            )}
            {sidebarFriendLinks.length > 0 ? (
              <div class="site-friend-links">
                <div class="site-friend-links-title"><i class="fa fa-fw fa-link" aria-hidden="true"></i> Links</div>
                <ul class="site-friend-links-ul">
                  {sidebarFriendLinks.map((link) => (
                    <li class="site-friend-links-item">
                      <a href={link.href} rel="noopener" target="_blank">{link.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <div style="height: 20px;"></div>
            )}
            {extraHtml && (
              <div id="leftbar_siteinfo_extra_tools" set:html={extraHtml}></div>
            )}
          </div>
          {widgets && (
            <div class="tab-pane fade" id="leftbar_tab_tools" role="tabpanel" aria-labelledby="leftbar_tab_tools_btn" set:html={widgets}></div>
          )}
        </div>
      </div>
    </div>
  </div>
</aside>
<div class="modal fade argon-modal-backdrop" id="blog_categories" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">{t(lang, "categories")}</h5>
        <button type="button" class="close" data-argon-modal-close aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        {categoryEntries.map(([cat, count]) => (
          <a href={"/categories/" + encodeURIComponent(cat) + "/"} class="badge badge-secondary tag">
            {cat} <span class="tag-num">{count}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>
<div class="modal fade argon-modal-backdrop" id="blog_tags" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">{t(lang, "tags")}</h5>
        <button type="button" class="close" data-argon-modal-close aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        {tagEntries.map(([tag, count]) => (
          <a href={"/tags/" + encodeURIComponent(tag) + "/"} class="badge badge-secondary tag">
            {tag} <span class="tag-num">{count}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>
{config.appearance.layout === "triple" && rightWidgetsHtml && (
  <aside id="rightbar" class="rightbar widget-area" role="complementary" set:html={rightWidgetsHtml}></aside>
)}
