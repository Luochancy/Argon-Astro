---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { loadThemeConfig } from "../../config/load";
import { publishedPosts, termCounts } from "../../lib/content/queries";
import { excerpt } from "../../lib/reading";
import { previewText } from "../../lib/preview-text.mjs";

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return [...termCounts(posts, "categories").keys()].map((category) => ({ params: { category } }));
}

const category = Astro.params.category ?? "";
const config = loadThemeConfig();
const isZh = config.site.language.toLowerCase().startsWith("zh");
const posts = (await publishedPosts()).filter((post) => post.data.categories.includes(category));
---
<Base title={category}>
  <div slot="page-info" class="page-information-card-container">
    <div class="page-information-card card bg-gradient-secondary shadow-lg border-0">
      <div class="card-body">
        <h3 class="text-black">{category}</h3>
        <p class="text-black mt-3 mb-0 opacity-8">
          <i class="fa fa-file-o mr-1"></i>
          {posts.length} {isZh ? "篇文章" : "posts"}
        </p>
      </div>
    </div>
  </div>
  {posts.map((post) => (
    <PostCard post={post} config={config} summary={excerpt(previewText(post.data.description ?? "", config.article.hideShortcodeInPreview), config.article.trimWords)} />
  ))}
</Base>
