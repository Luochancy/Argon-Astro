---
import Base from "../../layouts/Base.astro";
import { loadThemeConfig } from "../../config/load";
import { publishedPosts, termCounts } from "../../lib/content/queries";
import { t } from "../../lib/i18n";

const config = loadThemeConfig();
const lang = config.site.language;
const isZh = lang.toLowerCase().startsWith("zh");
const counts = [...termCounts(await publishedPosts(), "tags").entries()].sort((a, b) => b[1] - a[1]);
---
<Base title={t(lang, "tags")}>
  <div slot="page-info" class="page-information-card-container">
    <div class="page-information-card card bg-gradient-secondary shadow-lg border-0">
      <div class="card-body">
        <h3 class="text-black">{t(lang, "tags")}</h3>
        <p class="text-black mt-3 mb-0 opacity-8">
          <i class="fa fa-tags mr-1"></i>
          {counts.length} {isZh ? "个标签" : "tags"}
        </p>
      </div>
    </div>
  </div>
  <div class="card shadow-sm bg-white mb-4">
    <div class="card-body">
      {counts.map(([tag, count]) => (
        <a class="tag badge badge-secondary" href={"/tags/" + encodeURIComponent(tag) + "/"}>
          {tag} <span class="tag-num">{count}</span>
        </a>
      ))}
    </div>
  </div>
</Base>
