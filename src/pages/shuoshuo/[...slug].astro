---
import Base from "../../layouts/Base.astro";
import Comments from "../../components/Comments.astro";
import Share from "../../components/Share.astro";
import { loadThemeConfig } from "../../config/load";
import { publishedMoments, type ShuoshuoEntry } from "../../lib/content/queries";
import { renderCommentList } from "../../lib/comments/render.mjs";
import { buildShuoshuoJsonLd } from "../../lib/agent/jsonld.mjs";
import { entryMarkdownPath } from "../../lib/agent/markdown-export.mjs";
import { t } from "../../lib/i18n";

export function getStaticPaths() {
  return publishedMoments().map((item) => ({ params: { slug: item.id }, props: { item } }));
}

interface Props { item: ShuoshuoEntry }
const { item } = Astro.props;
const config = loadThemeConfig();
const lang = config.site.language;
const isZh = lang.toLowerCase().startsWith("zh");
const date = item.data.date;
const month = date.getMonth() + 1;
const day = String(date.getDate()).padStart(2, "0");
const year = date.getFullYear();
const hms = `${String(date.getHours()).padStart(2, "0")}:${String(date.getMinutes()).padStart(2, "0")}:${String(date.getSeconds()).padStart(2, "0")}`;
const upvoteId = item.data.wpId ?? item.id;
const bakedCommentsHtml = item.data.comments.length > 0 ? renderCommentList(item.data.comments) : "";
const markdownUrl = entryMarkdownPath(item);
const jsonLd = buildShuoshuoJsonLd(config, item);
---
<Base title={item.data.title || t(lang, "shuoshuo")} markdownUrl={markdownUrl} jsonLd={jsonLd}>
  <div class="shuoshuo-container">
    <div class="shuoshuo-meta shadow-sm">
      <span>
        <i class="fa fa-calendar-o" aria-hidden="true"></i>
        <span class="shuoshuo-date-month">{month}</span>{isZh ? " 月 " : " / "}
        <span class="shuoshuo-date-date">{day}</span>{isZh ? " 日 , " : " / "}
        <span class="shuoshuo-date-year">{year}</span>
        <div class="post-meta-devide">|</div>
        <i class="fa fa-clock-o" aria-hidden="true"></i>
        <span class="shuoshuo-date-time">{hms}</span>
      </span>
      {item.data.sticky && (
        <>
          <div class="post-meta-devide">|</div>
          <div class="post-meta-detail post-meta-detail-words">
            <i class="fa fa-thumb-tack" aria-hidden="true"></i>
            {t(lang, "sticky")}
          </div>
        </>
      )}
      {item.data.mood && (
        <>
          <div class="post-meta-devide">|</div>
          <div class="post-meta-detail post-meta-detail-words">{item.data.mood}</div>
        </>
      )}
    </div>
    <article class="card shuoshuo-main bg-white shadow-sm border-0" id={"moment-" + item.id}>
      {item.data.title && <a class="shuoshuo-title" href={"/shuoshuo/" + item.id + "/"}>{item.data.title}</a>}
      <div class="shuoshuo-content" id="post_content" set:html={item.html}></div>
      {item.data.images.length > 0 && (
        <div class="shuoshuo-images">
          {item.data.images.map((src) => <img src={src} alt="" loading="lazy" />)}
        </div>
      )}
      <div class="shuoshuo-operations">
        <button class="shuoshuo-upvote btn btn-icon btn-outline-primary btn-sm" type="button" data-id={upvoteId}>
          <span class="btn-inner--icon"><i class="fa fa-thumbs-o-up"></i></span>
          <span class="btn-inner--text" style="margin-left: 2px;">
            <span class="shuoshuo-upvote-num">{item.data.upvotes}</span>
            <i class="fa fa-spinner fa-spin" style="margin-left: 0;"></i>
          </span>
        </button>
      </div>
    </article>
  </div>
  {config.article.showShare && (
    <Share
      url={Astro.site ? new URL("/shuoshuo/" + item.id + "/", Astro.site).toString() : "/shuoshuo/" + item.id + "/"}
      title={item.data.title || t(lang, "shuoshuo")}
    />
  )}
  <Comments config={config} wpId={item.data.wpId} bakedCommentsHtml={bakedCommentsHtml} />
</Base>
