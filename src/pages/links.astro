---
import Base from "../layouts/Base.astro";
import Comments from "../components/Comments.astro";
import { loadThemeConfig } from "../config/load";
import { publishedPages } from "../lib/content/queries";
import { entryUrl } from "../lib/content/urls.mjs";
import { renderCommentList } from "../lib/comments/render.mjs";
import { t } from "../lib/i18n";

const config = loadThemeConfig();
const lang = config.site.language;
const wpLinksPage = publishedPages().find((page) => page.id === "links" || entryUrl(page) === "/links/");
const bakedCommentsHtml = wpLinksPage && wpLinksPage.data.comments.length > 0
  ? renderCommentList(wpLinksPage.data.comments)
  : "";
const showPageHtml = Boolean(wpLinksPage && wpLinksPage.html.trim());
const showConfigCards = config.friendLinks.length > 0 && !(showPageHtml && wpLinksPage!.html.includes("friend-links"));
---
<Base title={wpLinksPage?.data.title || t(lang, "links")}>
  <article class="post post-full card bg-white shadow-sm border-0">
    <header class="post-header text-center">
      <a class="post-title" href="/links/">{wpLinksPage?.data.title || t(lang, "links")}</a>
    </header>
    <div class="post-content" id="post_content">
      {showPageHtml && <Fragment set:html={wpLinksPage!.html} />}
      {showConfigCards && (
        <div class="friend-links friend-links-style1">
          <div class="row">
            {config.friendLinks.map((link) => (
              <div class="link mb-2 col-lg-6 col-md-6">
                <div class:list={["card shadow-sm friend-link-container", { "no-avatar": !link.avatar }]}>
                  {link.avatar && (
                    <img src={link.avatar} class="friend-link-avatar bg-gradient-secondary" alt={link.name} loading="lazy" />
                  )}<div class="friend-link-content">
                    <div class="friend-link-title title text-primary">
                      <a target="_blank" rel="noopener" href={link.url}>{link.name}</a>
                    </div>
                    <div class="friend-link-description">{link.description}</div>
                    <div class="friend-link-links">
                      <a href={link.url} target="_blank" rel="noopener" style="float:right; margin-right: 10px;">
                        <i class="fa fa-angle-right" style="font-weight: bold;"></i>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
  {wpLinksPage && (wpLinksPage.data.commentsOpen || wpLinksPage.data.comments.length > 0) && (
    <Comments config={config} wpId={wpLinksPage.data.wpId} bakedCommentsHtml={bakedCommentsHtml} />
  )}
</Base>
