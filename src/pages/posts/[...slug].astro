---
import Base from "../../layouts/Base.astro";
import Comments from "../../components/Comments.astro";
import Share from "../../components/Share.astro";
import PostMeta from "../../components/PostMeta.astro";
import { loadThemeConfig } from "../../config/load";
import { publishedPosts, relatedPosts, type PostEntry } from "../../lib/content/queries";
import { buildArticleJsonLd } from "../../lib/agent/jsonld.mjs";
import { entryMarkdownPath } from "../../lib/agent/markdown-export.mjs";
import { formatDate } from "../../lib/date-format.mjs";
import { isOutdated } from "../../lib/appearance.mjs";
import { outdatedNotice } from "../../lib/outdated.mjs";
import { bannerThumbnailCss } from "../../lib/banner-thumb.mjs";
import { firstImage } from "../../lib/thumbnail.mjs";
import { renderCommentList } from "../../lib/comments/render.mjs";
import { renderAfterPost } from "../../lib/rich-text.mjs";
import { t } from "../../lib/i18n";

export function getStaticPaths() {
  return publishedPosts().map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: PostEntry }
const { post } = Astro.props;
const config = loadThemeConfig();
const all = publishedPosts();
const related = relatedPosts(all, post, config.article.related, config.article.relatedLimit, config.article.relatedOrderBy, config.article.relatedOrder);
const index = all.findIndex((item) => item.id === post.id);
const prev = all[index + 1];
const next = all[index - 1];
const outdated = isOutdated(post.data.date, config.article.outdatedDays);
const outdatedDeltaDays = Math.max(0, Math.floor((Date.now() - post.data.date.getTime()) / 86400000));
const bannerThumb = bannerThumbnailCss(config.article.thumbnailInBanner, post.data.cover);
const hasHeaderThumb = Boolean(post.data.cover) && !config.article.thumbnailInBanner;
const lang = config.site.language;
const bakedCommentsHtml = post.data.comments.length > 0 ? renderCommentList(post.data.comments) : "";
const postUrl = Astro.site ? new URL("/posts/" + post.id + "/", Astro.site).toString() : "/posts/" + post.id + "/";
const afterPostRendered = renderAfterPost(config.article.afterPostHtml, {
  url: postUrl,
  title: post.data.title,
  author: config.sidebar.authorName || config.site.title,
});
const markdownUrl = entryMarkdownPath(post);
const jsonLd = buildArticleJsonLd(config, post);
---
<Base title={post.data.title} description={post.data.description} image={post.data.cover} catalog markdownUrl={markdownUrl} jsonLd={jsonLd}>
  {bannerThumb && <style set:html={bannerThumb}></style>}
  <article class="post post-full card bg-white shadow-sm border-0" id={"post-" + post.id}>
    <header class:list={["post-header text-center", { "post-header-with-thumbnail": hasHeaderThumb }]}>
      {hasHeaderThumb && <img class="post-thumbnail" src={post.data.cover} alt="" />}
      {hasHeaderThumb ? (
        <div class="post-header-text-container">
          <a class="post-title" href={"/posts/" + post.id + "/"}>{post.data.title}</a>
          <PostMeta post={post} config={config} />
        </div>
      ) : (
        <>
          <a class="post-title" href={"/posts/" + post.id + "/"}>{post.data.title}</a>
          <PostMeta post={post} config={config} />
        </>
      )}
    </header>
    {config.motion.readingProgress !== false && <div id="reading-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>}
    <div class="post-content" id="post_content">
      {outdated && <div set:html={outdatedNotice(config.article.outdatedTip, config.article.outdatedTipType, config.article.outdatedTimeType, formatDate(post.data.date, config.site.dateFormat), outdatedDeltaDays)}></div>}
      <Fragment set:html={post.html} />
    </div>
    {config.article.donateQr && (
      <div class="post-donate">
        <button class="btn donate-btn btn-danger" type="button">{t(lang, "donate")}</button>
        <div class="donate-qrcode card shadow-sm bg-white"><img src={config.article.donateQr} alt="" /></div>
      </div>
    )}
    {afterPostRendered && <div class="additional-content-after-post" set:html={afterPostRendered}></div>}
    {post.data.tags.length > 0 && (
      <div class="post-tags">
        <i class="fa fa-tags" aria-hidden="true"></i>
        {post.data.tags.map((tag) => <a class="tag badge badge-secondary post-meta-detail-tag" href={"/tags/" + encodeURIComponent(tag) + "/"}>{tag}</a>)}
      </div>
    )}
  </article>
  {config.article.showShare && <Share url={postUrl} title={post.data.title} />}
  <Comments config={config} wpId={post.data.wpId} bakedCommentsHtml={bakedCommentsHtml} />
  {(prev || next) && (
    <div class="post-navigation card shadow-sm border-0">
      <div class="post-navigation-item post-navigation-pre">{prev && (
        <><span class="page-navigation-extra-text"><i class="fa fa-arrow-circle-o-left" aria-hidden="true"></i>{t(lang, "prev")}</span><a href={"/posts/" + prev.id + "/"}>{prev.data.title}</a></>
      )}</div><div class="post-navigation-item post-navigation-next">{next && (
        <><span class="page-navigation-extra-text">{t(lang, "next")} <i class="fa fa-arrow-circle-o-right" aria-hidden="true"></i></span><a href={"/posts/" + next.id + "/"}>{next.data.title}</a></>
      )}</div>
    </div>
  )}
  {related.length > 0 && (
    <div class="related-posts card shadow-sm border-0">
      <h2 class="post-comment-title" style="margin-top:1.2rem;margin-left:1.5rem;margin-right:1.5rem;">
        <i class="fa fa-book"></i><span>{t(lang, "related")}</span>
      </h2>
      <div style="overflow-x:auto;padding:0.8rem 1.5rem;">
        {related.map((item) => {
          const itemCover = item.data.cover || (config.article.firstImageAsThumbnail ? firstImage(item.html) : "");
          return (
            <a class="related-post-card" href={"/posts/" + item.id + "/"}>
              <div class:list={["related-post-card-container", { "has-thumbnail": Boolean(itemCover) }]}>
                <div class="related-post-title clamp" clamp-line="3">{item.data.title}</div>
                <i class="related-post-arrow fa fa-chevron-right" aria-hidden="true"></i>
              </div>
              {itemCover && <img class="related-post-thumbnail" src={itemCover} alt="" loading="lazy" />}
            </a>
          );
        })}
      </div>
    </div>
  )}
</Base>
