---
import Base from "../layouts/Base.astro";
import Comments from "../components/Comments.astro";
import { loadThemeConfig } from "../config/load";
import { publishedPages, type PageEntry } from "../lib/content/queries";
import { renderCommentList } from "../lib/comments/render.mjs";
import { entryMarkdownPath } from "../lib/agent/markdown-export.mjs";

export function getStaticPaths() {
  const reserved = new Set(["posts", "shuoshuo", "archives", "tags", "categories", "search", "links", "page", "argon", "api", "media"]);
  return publishedPages()
    .filter((page) => !reserved.has(page.id))
    .map((page) => ({ params: { slug: page.id }, props: { page } }));
}

interface Props { page: PageEntry }
const { page } = Astro.props;
const config = loadThemeConfig();
const bakedCommentsHtml = page.data.comments.length > 0 ? renderCommentList(page.data.comments) : "";
const markdownUrl = entryMarkdownPath(page);
---
<Base title={page.data.title} description={page.data.description} markdownUrl={markdownUrl}>
  <article class="post post-full card bg-white shadow-sm border-0">
    <header class="post-header text-center">
      <a class="post-title" href={"/" + page.id + "/"}>{page.data.title}</a>
    </header>
    <div class="post-content" id="post_content" set:html={page.html}></div>
  </article>
  {page.data.template === "message" && <Comments config={config} wpId={page.data.wpId} bakedCommentsHtml={bakedCommentsHtml} />}
</Base>
