---
import Base from "../layouts/Base.astro";
import { loadThemeConfig } from "../config/load";
import { publishedMoments, publishedPages, publishedPosts } from "../lib/content/queries";
import { t } from "../lib/i18n";
import { enabledSearchKinds } from "../lib/search-kinds.mjs";

const config = loadThemeConfig();
const lang = config.site.language;
const isZh = lang.toLowerCase().startsWith("zh");
const kinds = enabledSearchKinds(config.article.searchFilters);
const index = [
  ...(kinds.includes("post") ? publishedPosts().map((post) => ({ kind: "post", title: post.data.title, href: "/posts/" + post.id + "/", text: post.data.description + " " + post.data.tags.join(" ") })) : []),
  ...(kinds.includes("page") ? publishedPages().map((page) => ({ kind: "page", title: page.data.title, href: "/" + page.id + "/", text: page.data.description })) : []),
  ...(kinds.includes("shuoshuo") ? publishedMoments().map((item) => ({ kind: "shuoshuo", title: item.data.title || "说说", href: "/shuoshuo/" + item.id + "/", text: item.data.mood })) : []),
];
---
<Base title={t(lang, "searchTitle")}>
  <div class="card shadow-sm bg-white mb-4">
    <div class="card-body">
      <h3 class="mb-3">{t(lang, "searchTitle")}</h3>
      <div class="input-group input-group-alternative">
        <div class="input-group-prepend">
          <span class="input-group-text"><i class="fa fa-search"></i></span>
        </div>
        <input id="local-search-input" class="form-control" type="text" autocomplete="off" placeholder={t(lang, "search")} />
      </div>
      {config.article.enableSearchFilters && (
        <div class="search-filters mt-3">
          {kinds.includes("post") && (
            <div class="custom-control custom-checkbox search-filter-wrapper">
              <input class="custom-control-input search-filter" id="search_filter_post" type="checkbox" data-search-kind="post" checked />
              <label class="custom-control-label" for="search_filter_post">{t(lang, "articles")}</label>
            </div>
          )}
          {kinds.includes("page") && (
            <div class="custom-control custom-checkbox search-filter-wrapper">
              <input class="custom-control-input search-filter" id="search_filter_page" type="checkbox" data-search-kind="page" checked />
              <label class="custom-control-label" for="search_filter_page">{isZh ? "页面" : "Pages"}</label>
            </div>
          )}
          {kinds.includes("shuoshuo") && (
            <div class="custom-control custom-checkbox search-filter-wrapper">
              <input class="custom-control-input search-filter" id="search_filter_shuoshuo" type="checkbox" data-search-kind="shuoshuo" checked />
              <label class="custom-control-label" for="search_filter_shuoshuo">{t(lang, "shuoshuo")}</label>
            </div>
          )}
        </div>
      )}
      <ul id="local-search-results" class="mt-3 mb-0"></ul>
    </div>
  </div>
  <script id="search-index" type="application/json" set:html={JSON.stringify(index)}></script>
</Base>
